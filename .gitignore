build/
dist/
*.manifest

# ---------------------------------------------------------------------------
# Saídas de QA e relatórios gerados
# ---------------------------------------------------------------------------
reports/

# ---------------------------------------------------------------------------
# Cache de execução do programa
#
# tmp/ é o diretório de cache do atualizador tarifário da ANEEL
# (netuno/core/tariff_updater/aneel_updater.py). O CSV baixado passa de 85 MB e
# é regenerável — não deve ser versionado.
# ---------------------------------------------------------------------------
tmp/
outputs/

# ---------------------------------------------------------------------------
# Base climática CMIP6 (~6,5 GB, 37.164 arquivos)
#
# Exigida em tempo de execução por netuno/core/climate_database.py, mas grande
# demais para controle de versão. Distribuída separadamente.
# ---------------------------------------------------------------------------
Netuno future files for 652 cities/

# Base climatica compilada: 784 MB, gerada por scripts/compilar_base_climbra.py
# a partir da pasta acima. O GitHub recusa arquivo com mais de 100 MB, e a base
# e um download a parte, como a pasta de origem.
data/climbra.db
Netuno_future_files_split/

# ---------------------------------------------------------------------------
# Saídas de simulação em lote (~514 MB, 4.055 arquivos gerados)
#
# EXCEÇÃO IMPORTANTE: as planilhas Planilha.csv são os resultados oficiais
# exportados do Netuno 4 e constituem a referência de validação da replicação
# (4.050 casos). Elas SÃO versionadas.
# ---------------------------------------------------------------------------
data/simulation_outputs/**
!data/simulation_outputs/
!data/simulation_outputs/*/
!data/simulation_outputs/**/Planilha.csv
# Projetos exportados do Netuno 4 usados como fixture do parser (~1,9 KB cada).
!data/simulation_outputs/*_Descarte*_Area*.csv

# ---------------------------------------------------------------------------
# Node / PNPM (versão web descontinuada — ver LegadoWeb/)
# ---------------------------------------------------------------------------
.pnpm-store/
node_modules/

# ---------------------------------------------------------------------------
# Sistema operacional e editores
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
.mcp.json

# Log de avisos do Qt, gerado em tempo de execucao
avisos_qt.log

# O manual montado, os mini manuais e o site sao gerados, mas VAO para o
# controle de versao: sao o que se manda para alguem ler, e quem clona o
# repositorio nao precisa montar nada para chegar ao texto. Regerar:
#   python manual/gerar.py && python manual/gerar_pdf.py
#   python manual/gerar_mini_manuais.py && python manual/gerar_site.py
manual/Manual-Netuno-5.pdf.novo

# ---------------------------------------------------------------------------
# Material de terceiros: usado para escrever o manual, nao redistribuido.
# Os arquivos continuam na maquina de quem escreve; fora do repositorio.
# ---------------------------------------------------------------------------
additional_material/documentation/*.pdf
