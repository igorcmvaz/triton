# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/

# Ambientes virtuais
venv/
venv_*/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Artefatos de compilação (PyInstaller / Inno Setup)
# ---------------------------------------------------------------------------
build/
dist/
*.manifest

# ---------------------------------------------------------------------------
# Saídas de QA e relatórios gerados
# ---------------------------------------------------------------------------
reports/**
!reports/
!reports/exemplos/
!reports/exemplos/**

# ---------------------------------------------------------------------------
# Cache de execução do programa
#
# tmp/ é o diretório de cache do atualizador tarifário da ANEEL
# (triton/core/tariff_updater/aneel_updater.py). O CSV baixado passa de 85 MB e
# é regenerável — não deve ser versionado.
# ---------------------------------------------------------------------------
tmp/
outputs/

# ---------------------------------------------------------------------------
# Base climática CMIP6 (~6,5 GB, 37.164 arquivos CSV)
#
# Exigida só para recompilar os bancos (scripts/compilar_base_climbra.py); grande
# demais para controle de versão. Distribuída separadamente.
# ---------------------------------------------------------------------------
climbra_data/
Triton future files for 652 cities/
Triton_future_files_split/

# Base climática compilada: um banco por modelo, data/climbra_<modelo>.db (40 a 44 MB cada,
# 19 arquivos, ~785 MB), VERSIONADOS. O GitHub avisa a partir de 50 MiB e recusa acima de 100 MiB
# por arquivo; o projeto adota 50 MiB e a maior parte tem 43 MiB (ver scripts/README.md). Não os apague nem os
# regere sem necessidade: cada regeração grava no histórico outra cópia de ~785 MB.
# O climbra.db ÚNICO das versões antigas (~820 MB) passa do limite e fica fora do Git; o
# programa ainda o lê, e scripts/dividir_base_climbra.py o converte nas partes.
data/climbra.db

# ---------------------------------------------------------------------------
# Saídas de simulação em lote (~514 MB, 4.055 arquivos gerados)
#
# EXCEÇÃO IMPORTANTE: as planilhas Planilha.csv são os resultados oficiais
# exportados do Netuno 4 e constituem a referência de validação da replicação
# (4.050 casos). Elas SÃO versionadas.
# ---------------------------------------------------------------------------
data/simulation_outputs/**
!data/simulation_outputs/
!data/simulation_outputs/*/
!data/simulation_outputs/**/Planilha.csv
# Projetos exportados do Netuno 4 usados como fixture do parser (~1,9 KB cada).
!data/simulation_outputs/*_Descarte*_Area*.csv

# ---------------------------------------------------------------------------
# Node / PNPM (versão web descontinuada)
# ---------------------------------------------------------------------------
.pnpm-store/
node_modules/

# ---------------------------------------------------------------------------
# Sistema operacional e editores
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
.mcp.json

# Log de avisos do Qt, gerado em tempo de execucao
avisos_qt.log

# O manual montado, os mini manuais e o site sao gerados, mas VAO para o
# controle de versao: sao o que se manda para alguem ler, e quem clona o
# repositorio nao precisa montar nada para chegar ao texto. Regerar:
#   python manual/gerar.py && python manual/gerar_pdf.py
#   python manual/gerar_mini_manuais.py && python manual/gerar_site.py
manual/Manual-Triton.pdf.novo

# ---------------------------------------------------------------------------
# Material de terceiros: usado para escrever o manual, nao redistribuido.
# Os arquivos continuam na maquina de quem escreve; fora do repositorio.
# ---------------------------------------------------------------------------
additional_material/documentation/*.pdf

# Apresentações ficam fora do repositório (decisão de 28/09/2026)
apresentacoes/

# Rascunhos de depuração locais
scratch/
scratch_*.py
*.log

# Commit compilado, gravado pelo build_exe.py e lido pelo --diagnostico
triton/data/revisao.json

# ---------------------------------------------------------------------------
# Caixa de entrada de coleta tarifária
# Arquivos brutos baixados (PDFs, HTMLs) usados apenas localmente para gerar o DB.
# Não devem ser enviados ao GitHub.
# ---------------------------------------------------------------------------
tarifas/entrada/*
!tarifas/entrada/LEIAME.md


# Edição Ibérica (IBE): fontes brutas (E-OBS, CAOP), vários GB; só a base derivada vai no programa
data/portugal/fontes/
tarifas_portugal/fontes/_fora_do_tema/
tarifas_portugal/fontes/_secundarios/

# Documentos de terceiros (PDFs e páginas salvas de prestadores e agências): ficam só no disco do mantenedor.
# O que vai ao Git é o registro: hash e URL em procedencia.tsv, e o registro.json que os testes leem.
tarifas/fontes/*
!tarifas/fontes/registro.json
!tarifas/fontes/REGISTRO.md
!tarifas/fontes/LEIAME.md
!tarifas/fontes/procedencia.tsv
# O banco que reúne esses documentos (scripts/compilar_base_tarifas_fontes.py) também fica fora do Git.
tarifas/tarifas_fontes.db

# ---------------------------------------------------------------------------
# Ferramentas de desenvolvimento: ficam no disco do mantenedor, fora do Git.
# Geradores de dados e de documentos, auditorias, desempenho, QA, coleta e transcrição de tarifas,
# compilação e divisão das bases, replicação do Netuno 4 e o atualizador tarifário. O programa, o
# instalador e os testes mantidos não dependem de nada disso (o build_exe.py usa o que existir).
# ---------------------------------------------------------------------------
scripts/**/*.py
# ...exceto os que reproduzem a base climática versionada (partes data/climbra_<modelo>.db)
!scripts/dividir_base_climbra.py
!scripts/compilar_base_climbra.py
tarifas/*.py
tarifas_portugal/*.py
docs/gerar_figuras.py
tests/benchmarking/generate_test_cases.py
triton/core/tariff_updater/
# Testes que só existem para essas ferramentas (coleta e transcrição de tarifas).
tests/unit/test_processar_entrada.py
tests/unit/test_processo_tarifario.py
tests/unit/test_registro_de_fontes.py
tests/unit/test_transcricoes.py

# Logs de build e de instalação, e arquivos de cobertura (regeráveis; nunca versionar)
build_log.txt
install_*.log
avisos_qt.log
.coverage
.coverage.*

# Cache gerado pelo auditor de cobertura das transcrições (regerável)
tarifas/transcricoes/.cobertura_cache.json
