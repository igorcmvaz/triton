(function () {
  "use strict";

  var CFG = window.RIC_A11Y || {};
  var SEL_CONTEUDO = CFG.conteudo ||
    '[data-elementor-type]:not([data-elementor-type="header"]):not([data-elementor-type="popup"]), main, #content, #primary, .site-main';
  var ESCALA_MIN = 1, ESCALA_MAX = 1.6, ESCALA_PASSO = 0.1;
  var LS = { escala: "ricEscala", contraste: "ricContraste" };

  var root = document.documentElement;

  if (CFG.offsetBottom) root.style.setProperty("--ric-a11y-offset", CFG.offsetBottom);
  if (CFG.offsetBottomMobile) root.style.setProperty("--ric-a11y-offset-mobile", CFG.offsetBottomMobile);

  function salvar(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function ler(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }

  function aplicarEscala(v) {
    root.style.setProperty("--ric-a11y-escala", v);
    salvar(LS.escala, String(v));
  }
  function escalaAtual() {
    var v = parseFloat(ler(LS.escala));
    return isNaN(v) ? 1 : v;
  }
  function mudarFonte(dir) {
    var v = Math.min(ESCALA_MAX, Math.max(ESCALA_MIN, escalaAtual() + dir * ESCALA_PASSO));
    v = Math.round(v * 100) / 100;
    aplicarEscala(v);
  }

  function setContraste(ativo, btn) {
    root.classList.toggle("ric-alto-contraste", ativo);
    salvar(LS.contraste, ativo ? "1" : "0");
    if (btn) btn.setAttribute("aria-pressed", ativo ? "true" : "false");
  }

  var falando = false;

  // Usado apenas para definir o alvo do skip-link (precisa de UM único elemento com id)
  function elementoPrincipal() {
    var els = document.querySelectorAll(SEL_CONTEUDO);
    if (!els.length) return document.body;
    var melhor = els[0], melhorLen = (els[0].innerText || "").length;
    for (var i = 1; i < els.length; i++) {
      var len = (els[i].innerText || "").length;
      if (len > melhorLen) { melhor = els[i]; melhorLen = len; }
    }
    return melhor;
  }

  // Alt de imagens puramente decorativas — não entram na leitura por voz
  var ALT_DECORATIVO = /^(waves?|wave background)$/i;

  function elementoVisivel(el) {
    var s = window.getComputedStyle(el);
    if (s.display === "none" || s.visibility === "hidden") return false;
    var r = el.getBoundingClientRect();
    return r.width > 0 && r.height > 0;
  }

  // Percorre o DOM em ORDEM VISUAL real (texto e imagens intercalados
  // exatamente como aparecem na página), em vez de ler todo o texto do
  // container primeiro e só depois as imagens — isso fazia o banner
  // (que é imagem, e é o 1º elemento visual da home) ser narrado só
  // depois de "Sobre a RIC", "Canais de Atendimento" etc.
  function textoDoConteudo() {
    var raizes = document.querySelectorAll(SEL_CONTEUDO);
    var partes = [];
    var vistos = {};

    function empilhar(t) {
      t = t.replace(/\s+/g, " ").trim();
      if (t && !vistos[t]) { vistos[t] = true; partes.push(t); }
    }

    raizes.forEach(function (raiz) {
      var walker = document.createTreeWalker(
        raiz,
        NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT,
        {
          acceptNode: function (node) {
            if (node.nodeType === 1) {
              // pula containers já cobertos por outra raiz (evita raiz aninhada duplicada)
              if (node !== raiz && node.matches && node.matches(SEL_CONTEUDO)) return NodeFilter.FILTER_REJECT;
              if (node.tagName === "IMG") return NodeFilter.FILTER_ACCEPT;
              if (!elementoVisivel(node)) return NodeFilter.FILTER_REJECT;
              return NodeFilter.FILTER_SKIP;
            }
            // texto: só nós filhos diretos de elemento visível
            if (!node.parentElement || !elementoVisivel(node.parentElement)) return NodeFilter.FILTER_REJECT;
            return node.textContent.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
          }
        }
      );
      var atual;
      while ((atual = walker.nextNode())) {
        if (atual.nodeType === 3) {
          empilhar(atual.textContent);
        } else if (atual.tagName === "IMG") {
          if (!elementoVisivel(atual)) continue;
          var alt = (atual.getAttribute("alt") || "").trim();
          if (!alt || ALT_DECORATIVO.test(alt)) continue;
          alt = alt.replace(/\s+\d+$/, "").trim(); // remove sufixo numérico automático (ex: "Início 8")
          empilhar(alt);
        }
      }
    });

    return partes.join(". ").replace(/\s+/g, " ").trim();
  }

  function escolherVoz() {
    var vozes = window.speechSynthesis.getVoices() || [];
    return vozes.find(function (v) { return /pt[-_]BR/i.test(v.lang); })
        || vozes.find(function (v) { return /^pt/i.test(v.lang); })
        || null;
  }
  function ouvir(btn) {
    if (!("speechSynthesis" in window)) {
      alert("Seu navegador não suporta leitura de conteúdo por voz.");
      return;
    }
    var synth = window.speechSynthesis;
    if (falando) {
      synth.cancel();
      return;
    }
    var u = new SpeechSynthesisUtterance(textoDoConteudo());
    u.lang = "pt-BR";
    var voz = escolherVoz();
    if (voz) u.voice = voz;
    u.rate = 1; u.pitch = 1;
    u.onstart = function () {
      falando = true;
      btn.setAttribute("aria-pressed", "true");
      btn.querySelector(".ric-a11y-opt__label").textContent = "Parar";
    };
    u.onend = u.onerror = function () {
      falando = false;
      btn.setAttribute("aria-pressed", "false");
      btn.querySelector(".ric-a11y-opt__label").textContent = "Ouvir";
    };
    synth.cancel();
    synth.speak(u);
  }

  var ICONES = {
    acessibilidade:
      '<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">' +
      '<path d="M32 0H8C3.58172 0 0 3.58172 0 8V32C0 36.4183 3.58172 40 8 40H32C36.4183 40 40 36.4183 40 32V8C40 3.58172 36.4183 0 32 0Z" fill="url(#ric-a11y-grad)"/>' +
      '<path d="M19.8862 23.7503L17.3469 31.028C17.2845 31.2104 17.1876 31.378 17.0619 31.521C16.9362 31.664 16.7842 31.7795 16.6149 31.8608C16.3606 31.9845 16.0766 32.0271 15.7989 31.9832C15.5213 31.9393 15.2624 31.8108 15.0552 31.6142C14.8479 31.4175 14.7016 31.1614 14.6349 30.8784C14.5681 30.5954 14.5838 30.2982 14.68 30.0245L16.4504 24.9392C16.5909 24.5565 16.7019 24.1629 16.7823 23.762C16.8539 23.355 16.905 22.9444 16.9355 22.5319C17.0036 21.7874 17.0519 20.981 17.0887 20.207C17.1256 19.4331 17.1512 18.6826 17.171 18.0617C17.1966 17.2877 16.9951 17.2377 16.3965 17.0905L16.2716 17.0611L11.1648 16.0635C10.9811 16.0299 10.8056 15.959 10.6484 15.855C10.4912 15.751 10.3552 15.6158 10.2484 15.4572C10.0897 15.217 10.0033 14.9334 10.0001 14.6422C9.99691 14.351 10.0771 14.0653 10.2305 13.8214C10.3839 13.5775 10.6037 13.3863 10.8619 13.2721C11.1201 13.1578 11.4052 13.1256 11.6812 13.1795L17.1682 14.2477C17.3866 14.2683 17.5994 14.2948 17.8236 14.3213C18.4988 14.4173 19.1791 14.4694 19.8606 14.4773C20.709 14.4601 21.5557 14.3943 22.397 14.2801C22.6524 14.2507 22.8935 14.2183 23.1347 14.1948L28.3125 13.1883C28.6798 13.1093 29.0623 13.1844 29.3764 13.3972C29.5321 13.5065 29.6652 13.6467 29.7682 13.8098C29.8711 13.9729 29.9418 14.1556 29.9762 14.3472C30.0105 14.5389 30.0077 14.7357 29.9681 14.9263C29.9284 15.1168 29.8527 15.2973 29.7452 15.4572C29.6399 15.6168 29.5052 15.7533 29.3489 15.8588C29.1926 15.9644 29.0178 16.0369 28.8345 16.0723L23.8865 17.0376C23.722 17.0758 23.5744 17.1023 23.4439 17.1229C22.9276 17.2141 22.6722 17.2612 22.7034 18.0234C22.7261 18.5796 22.7914 19.2447 22.8765 19.9392C22.9758 20.7544 23.1063 21.6196 23.2425 22.4113C23.3305 22.9321 23.4127 23.35 23.5262 23.7503C23.6397 24.1505 23.7504 24.5596 23.9206 25.051L25.6541 30.0245C25.7503 30.2982 25.766 30.5954 25.6992 30.8784C25.6324 31.1614 25.4862 31.4175 25.2789 31.6142C25.0717 31.8108 24.8128 31.9393 24.5351 31.9832C24.2575 32.0271 23.9735 31.9845 23.7191 31.8608C23.5498 31.7795 23.3979 31.664 23.2722 31.521C23.1465 31.378 23.0496 31.2104 22.9872 31.028L20.4394 23.765L20.1557 23.2264L19.872 23.7503H19.8862ZM19.9968 8C20.5764 7.99949 21.1383 8.20747 21.5866 8.5885C22.035 8.96952 22.3421 9.50002 22.4556 10.0896C22.5691 10.6792 22.4821 11.2913 22.2092 11.8218C21.9364 12.3522 21.4947 12.7681 20.9593 12.9986C20.424 13.2291 19.8282 13.2599 19.2734 13.0857C18.7186 12.9116 18.2392 12.5433 17.9169 12.0437C17.5945 11.544 17.4492 10.9439 17.5057 10.3455C17.5621 9.74713 17.8168 9.18759 18.2264 8.76221C18.4585 8.52032 18.7344 8.32844 19.0382 8.19763C19.342 8.06681 19.6678 7.99965 19.9968 8Z" fill="white"/>' +
      '<defs><linearGradient id="ric-a11y-grad" x1="42" y1="-1.01328e-07" x2="-9.5" y2="43" gradientUnits="userSpaceOnUse">' +
      '<stop stop-color="#3690FA"/><stop offset="1" stop-color="#2266D2"/></linearGradient></defs></svg>',
    fechar:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 5l14 14M19 5 5 19"/></svg>',
    fonteMais:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M4 18 9 6l5 12M5.5 14h7"/><path d="M16 11h6M19 8v6"/></svg>',
    fonteMenos:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M4 18 9 6l5 12M5.5 14h7"/><path d="M16 11h6"/></svg>',
    contraste:
      '<svg viewBox="0 0 24 24">' +
      '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/>' +
      '<path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor"/></svg>',
    ouvir:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor" stroke="none"/>' +
      '<path d="M16.5 8.5a5 5 0 0 1 0 7M19.5 6a9 9 0 0 1 0 12"/></svg>'
  };

  function opcao(icone, rotulo, aria, aoClicar, alternavel) {
    var b = document.createElement("button");
    b.type = "button";
    b.className = "ric-a11y-opt";
    b.setAttribute("aria-label", aria);
    if (alternavel) b.setAttribute("aria-pressed", "false");
    b.innerHTML = icone + '<span class="ric-a11y-opt__label">' + rotulo + "</span>";
    b.addEventListener("click", function () { aoClicar(b); });
    return b;
  }

  function montar() {

    var alvo = elementoPrincipal();
    if (alvo && !alvo.id) alvo.id = "ric-conteudo";
    var skip = document.createElement("a");
    skip.className = "ric-a11y-skip";
    skip.href = "#" + (alvo ? alvo.id : "ric-conteudo");
    skip.textContent = "Pular para o conteúdo";
    document.body.insertBefore(skip, document.body.firstChild);

    var wrap = document.createElement("div");
    wrap.className = "ric-a11y-wrap";

    var toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = "ric-a11y-toggle";
    toggle.setAttribute("aria-haspopup", "dialog");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-controls", "ric-a11y-panel");
    toggle.setAttribute("aria-label", "Abrir opções de acessibilidade");
    toggle.innerHTML = ICONES.acessibilidade +
      '<span class="ric-a11y-toggle__label" aria-hidden="true">Acessibilidade</span>';

    var panel = document.createElement("div");
    panel.id = "ric-a11y-panel";
    panel.className = "ric-a11y-panel";
    panel.setAttribute("role", "dialog");
    panel.setAttribute("aria-label", "Opções de acessibilidade");
    panel.hidden = true;

    var header = document.createElement("div");
    header.className = "ric-a11y-panel__header";
    var titulo = document.createElement("span");
    titulo.className = "ric-a11y-panel__title";
    titulo.textContent = "Acessibilidade";
    var fechar = document.createElement("button");
    fechar.type = "button";
    fechar.className = "ric-a11y-panel__close";
    fechar.setAttribute("aria-label", "Fechar opções de acessibilidade");
    fechar.innerHTML = ICONES.fechar;
    header.appendChild(titulo);
    header.appendChild(fechar);

    var grid = document.createElement("div");
    grid.className = "ric-a11y-grid";
    grid.appendChild(opcao(ICONES.fonteMais, "Aumentar fonte", "Aumentar o tamanho da fonte", function () { mudarFonte(+1); }));
    grid.appendChild(opcao(ICONES.fonteMenos, "Diminuir fonte", "Diminuir o tamanho da fonte", function () { mudarFonte(-1); }));
    var btnContraste = opcao(ICONES.contraste, "Alto contraste", "Ativar ou desativar o alto contraste", function (b) {
      setContraste(!root.classList.contains("ric-alto-contraste"), b);
    }, true);
    grid.appendChild(btnContraste);
    grid.appendChild(opcao(ICONES.ouvir, "Ouvir", "Ouvir o conteúdo da página", function (b) { ouvir(b); }, true));

    panel.appendChild(header);
    panel.appendChild(grid);
    wrap.appendChild(toggle);
    wrap.appendChild(panel);
    document.body.appendChild(wrap);

    function abrirPainel() {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      document.addEventListener("click", aoClicarFora, true);
      document.addEventListener("keydown", aoTeclar);
    }
    function fecharPainel(devolverFoco) {
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      document.removeEventListener("click", aoClicarFora, true);
      document.removeEventListener("keydown", aoTeclar);
      if (devolverFoco) toggle.focus();
    }
    function aoClicarFora(e) {
      if (!wrap.contains(e.target)) fecharPainel(false);
    }
    function aoTeclar(e) {
      if (e.key === "Escape") fecharPainel(true);
    }
    toggle.addEventListener("click", function () {
      if (panel.hidden) abrirPainel(); else fecharPainel(true);
    });
    fechar.addEventListener("click", function () { fecharPainel(true); });

    aplicarEscala(escalaAtual());
    if (ler(LS.contraste) === "1") setContraste(true, btnContraste);
  }

  if ("speechSynthesis" in window) window.speechSynthesis.onvoiceschanged = escolherVoz;

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", montar);
  } else {
    montar();
  }
})();