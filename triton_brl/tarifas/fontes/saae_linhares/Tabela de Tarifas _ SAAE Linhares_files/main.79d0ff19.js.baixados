e {\n          width: 100%;\n          height: 200px;\n          object-fit: cover;\n          transition: transform 0.3s ease;\n        }\n\n        .news-list-item:hover .news-list-image {\n          transform: scale(1.05);\n        }\n\n        .pdf-icon-wrapper {\n          width: 100%;\n          height: 200px;\n          background: linear-gradient(135deg, #f1f5f9, #e2e8f0);\n          display: flex;\n          flex-direction: column;\n          align-items: center;\n          justify-content: center;\n          gap: 0.5rem;\n        }\n\n        .pdf-icon-large {\n          font-size: 4rem;\n          color: #dc2626;\n        }\n\n        .pdf-icon-wrapper span {\n          font-size: 0.9rem;\n          color: #4b5563;\n          font-weight: 500;\n        }\n\n        .news-list-content {\n          flex: 1;\n          padding: 1.5rem 1.5rem 1.5rem 0;\n        }\n\n        .news-list-content h2 {\n          margin: 0 0 0.75rem 0;\n          font-size: 1.3rem;\n        }\n\n        .news-list-content h2 a {\n          color: #1a2b3c;\n          text-decoration: none;\n          transition: color 0.3s ease;\n        }\n\n        .news-list-content h2 a:hover {\n          color: #0066b3;\n        }\n\n        .news-summary {\n          color: #4a5568;\n          line-height: 1.6;\n          margin-bottom: 1rem;\n        }\n\n        .news-list-meta {\n          display: flex;\n          gap: 1.5rem;\n          margin-bottom: 1rem;\n          font-size: 0.85rem;\n          color: #94a3b8;\n        }\n\n        .news-list-meta span {\n          display: flex;\n          align-items: center;\n          gap: 0.5rem;\n        }\n\n        .read-more {\n          display: inline-flex;\n          align-items: center;\n          gap: 0.5rem;\n          color: #0066b3;\n          text-decoration: none;\n          font-weight: 500;\n          transition: all 0.3s ease;\n        }\n\n        .read-more:hover {\n          gap: 0.8rem;\n          color: #00a896;\n        }\