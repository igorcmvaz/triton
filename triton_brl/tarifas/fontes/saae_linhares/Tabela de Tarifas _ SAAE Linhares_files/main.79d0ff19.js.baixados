10px;\n          left: 0;\n          width: 80px;\n          height: 4px;\n          background: linear-gradient(135deg, #0066b3, #00a896);\n          border-radius: 2px;\n        }\n\n        .header-description {\n          color: #64748b;\n          margin-top: 1rem;\n          font-size: 1rem;\n        }\n\n        .filters-section {\n          display: flex;\n          gap: 1rem;\n          margin: 2rem 0 1rem;\n          flex-wrap: wrap;\n        }\n\n        .search-box {\n          flex: 2;\n          position: relative;\n          min-width: 250px;\n        }\n\n        .search-box svg {\n          position: absolute;\n          left: 1rem;\n          top: 50%;\n          transform: translateY(-50%);\n          color: #94a3b8;\n        }\n\n        .search-box input {\n          width: 100%;\n          padding: 0.85rem 2.5rem 0.85rem 2.5rem;\n          border: 2px solid #e2e8f0;\n          border-radius: 12px;\n          font-size: 0.95rem;\n          transition: all 0.3s ease;\n          background: white;\n        }\n\n        .search-box input:focus,\n        .filter-group select:focus {\n          outline: none;\n          border-color: #0066b3;\n          box-shadow: 0 0 0 3px rgba(0,102,179,0.1);\n        }\n\n        .clear-btn {\n          position: absolute;\n          right: 1rem;\n          top: 50%;\n          transform: translateY(-50%);\n          background: none;\n          border: none;\n          font-size: 1rem;\n          color: #94a3b8;\n          cursor: pointer;\n        }\n\n        .filter-group {\n          position: relative;\n          min-width: 180px;\n        }\n\n        .filter-icon {\n          position: absolute;\n          left: 1rem;\n          top: 50%;\n          transform: translateY(-50%);\n          color: #94a3b8;\n          font-size: 0.9rem;\n          pointer-events: none;\n        }\n\n        .filter-group select {\n          width: 100%;\n          padding: 0.85rem 1rem 0.85rem 2.5rem;\n          border: 2px solid #e2e8f0;\n          border-radius: 12px;\n          font-size: 0.95rem;\n          background: white;\n          cursor: pointer;\n          transition: all 0.3s ease;\n          appearance: none;\n        }\n\n        .results-count {\n          font-size: 0.85rem;\n          color: #64748b;\n          margin-bottom: 1rem;\n          padding: 0.5rem 0;\n          border-bottom: 1px solid #e2e8f0;\n        }\n\n        .loading,\n        .no-results {\n          text-align: center;\n          padding: 3rem;\n        }\n\n        .spinner {\n          width: 40px;\n          height: 40px;\n          border: 3px solid #e2e8f0;\n          border-top-color: #0066b3;\n          border-radius: 50%;\n          animation: spin 1s linear infinite;\n          margin: 0 auto;\n        }\n\n        @keyframes spin {\n          to {\n            transform: rotate(360deg);\n          }\n        }\n\n        .bids-table-container {\n          background: white;\n          border-radius: 20px;\n          box-shadow: 0 4px 20px rgba(0,0,0,0.05);\n          overflow-x: auto;\n          border: 1px solid #e9ecef;\n        }\n\n        .bids-table {\n          width: 100%;\n          border-collapse: collapse;\n          min-width: 980px;\n        }\n\n        .bids-table thead {\n          background: linear-gradient(135deg, #f8fafc, #f1f5f9);\n          border-bottom: 2px solid #e2e8f0;\n        }\n\n        .bids-table th,\n        .bids-table td {\n          padding: 1rem 1.25rem;\n          text-align: left;\n          vertical-align: middle;\n        }\n\n        .bids-table td {\n          border-bottom: 1px solid #e9ecef;\n          color: #2c3e50;\n          font-size: 0.9rem;\n        }\n\n        .bid-row {\n          cursor: pointer;\n          transition: all 0.2s ease;\n        }\n\n        .bid-row:hover {\n          background: #f8fafc;\n        }\n\n        .year-cell {\n          font-weight: 700;\n          color: #0066b3;\n        }\n\n        .process-cell {\n          font-family: 'Courier New', monospace;\n        }\n\n        .modality-cell {\n          color: #64748b;\n        }\n\n        .object-cell {\n          max-width: 360px;\n          color: #4a5568;\n          line-height: 1.5;\n        }\n\n        .detail-link {\n          color: #0066b3;\n          text-decoration: none;\n          font-weight: 600;\n        }\n\n        .detail-link.secondary {\n          display: inline-block;\n          margin-top: 0.5rem;\n          font-size: 0.85rem;\n        }\n\n        .date-cell {\n          color: #64748b;\n          white-space: nowrap;\n        }\n\n        .action-cell {\n          text-align: center;\n        }\n\n        .status-badge {\n          display: inline-block;\n          padding: 0.3rem 0.8rem;\n          border-radius: 20px;\n          font-size: 0.7rem;\n          font-weight: 600;\n          text-transform: uppercase;\n          letter-spacing: 0.5px;\n        }\n\n        .status-aberta {\n          background: #e3f2fd;\n          color: #1976d2;\n        }\n\n        .status-andamento {\n          background: #fff3e0;\n          color: #f57c00;\n        }\n\n        .status-homologada {\n          background: #e8f5e8;\n          color: #2e7d32;\n        }\n\n        .status-fracassada,\n        .status-deserta,\n        .status-cancelada,\n        .status-revogada {\n          background: #ffebee;\n          color: #c62828;\n        }\n\n        .status-deserta {\n          background: #fff4e5;\n          color: #b45309;\n        }\n\n        .status-suspensa {\n          background: #ede9fe;\n          color: #6d28d9;\n        }\n\n        .pdf-btn {\n          display: inline-flex;\n          align-items: center;\n          gap: 0.5rem;\n          padding: 0.5rem 1rem;\n          background: linear-gradient(135deg, #ef4444, #dc2626);\n          color: white;\n          border: none;\n          border-radius: 8px;\n          font-size: 0.8rem;\n          font-weight: 500;\n          curso