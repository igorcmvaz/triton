",contentClassName:"lgpd-content"}),Is=()=>(0,o().jsx)(Rs,{slug:"historia",fallbackTitle:"Historia",rootLabel:"SAAE",pageLabel:"Historia",fallbackContent:"\n  <p>Criado por meio da Lei no 67, de 29 de julho de 1957, e reestruturado pela Lei no 314, de 5 de dezembro de 1966, o Servico Autonomo de Agua e Esgoto de Linhares (SAAE) e uma Autarquia Municipal, com personalidade juridica propria e autonomia economico-financeira e administrativa.</p>\n  <p>Suas atividades principais sao a captacao, o tratamento e a distribuicao de agua, alem da coleta e do tratamento de esgoto sanitario.</p>\n  <p>Ao longo da sua historia, o SAAE Linhares consolidou sua atuacao como um servico essencial para a cidade, ampliando infraestrutura e melhorando o atendimento a populacao.</p>\n",contentClassName:"historia-content"}),Bs=()=>(0,o().jsx)(Rs,{slug:"missao",fallbackTitle:"Missao",rootLabel:"SAAE",pageLabel:"Missao",fallbackContent:"\n  <p>Prestar servicos de saneamento com qualidade e respeito ao meio ambiente, fortalecendo o compromisso com o cidadao por meio da melhoria continua da gestao.</p>\n",contentClassName:"missao-content"}),$s=()=>(0,o().jsx)(Rs,{slug:"lgpd",fallbackTitle:"LGPD - Lei Geral de Protecao de Dados",rootLabel:"SAAE",pageLabel:"LGPD",downloadButtonText:"Baixar PDF da LGPD",contentClassName:"lgpd-content"}),Hs=()=>(0,o().jsx)("div",{children:(0,o().jsx)("h1",{children:"Webmail"})}),Us=()=>(0,o().jsx)("div",{children:(0,o().jsx)("h1",{children:"Contracheque"})}),Vs=()=>(0,o().jsx)("div",{children:(0,o().jsx)("h1",{children:"Login do Servidor"})}),Ws=()=>(0,o().jsx)(Rs,{slug:"hidrometro",fallbackTitle:"Seu Hidrometro",rootLabel:"Servicos",pageLabel:"Seu Hidrometro",metaDescription:"Informacoes e orientacoes sobre o hidrometro e a leitura do consumo de agua.",fallbackContent:"\n  <p>O hidrometro e o equipamento responsavel por medir o consumo de agua do imovel. Mantenha o acesso livre, protegido contra danos e acompanhe com frequencia a leitura para identificar variacoes no consumo.</p>\n  <p>Em caso de suspeita de vazamento, consumo atipico ou necessidade de orientacao tecnica, entre em contato com o SAAE Linhares pelos canais oficiais de atendimento.</p>\n",contentClassName:"content-page-body"}),Qs=()=>(0,o().jsx)(Rs,{slug:"informacoes-tecnicas",fallbackTitle:"Informacoes Tecnicas",rootLabel:"Servicos",pageLabel:"Informacoes Tecnicas",metaDescription:"Informacoes tecnicas sobre os sistemas de agua e esgoto do SAAE Linhares.",fallbackContent:"\n  <h2>Informacoes Tecnicas</h2>\n  <p>Esta pagina reune informacoes tecnicas sobre os sistemas de agua e esgoto do SAAE Linhares. Todo o conteudo passa a ser administrado pelo portal, permitindo atualizar textos, tabelas, imagens e documentos sem novo deploy.</p>\n  <p>Use o portal administrativo para organizar as secoes internas, incluir arquivos complementares e manter o material tecnico sempre atualizado.</p>\n",contentClassName:"content-page-body"}),Ys=()=>{const[e,n]=(0,s().useState)([]),[t,a]=(0,s().useState)(""),[r,i]=(0,s().useState)(!0);(0,s().useEffect)(()=>{(async()=>{try{const e=await Yr.get("/dictionary");n(e.data)}catch(e){console.error("Erro ao carregar dicion\xe1rio:",e)}finally{i(!1)}})()},[]);const l=e.filter(e=>e.term.toLowerCase().includes(t.toLowerCase())||e.definition.toLowerCase().includes(t.toLowerCase()));return(0,o().jsxs)(Os,{children:[(0,o().jsx)($n,{children:(0,o().jsx)("title",{children:"Dicion\xe1rio de Termos | SAAE Linhares"})}),(0,o().jsx)(Ps,{items:[{label:"In\xedcio",link:"/"},{label:"Servi\xe7os",link:null},{label:"Dicion\xe1rio"}]}),(0,o().jsx)("div",{className:"dicionario-page",children:(0,o().jsxs)("div",{className:"container",children:[(0,o().jsxs)("div",{className:"page-header",children:[(0,o().jsx)("h1",{children:"Dicion\xe1rio de Termos"}),(0,o().jsx)("p",{className:"header-description",children:"Consulte os significados dos termos t\xe9cnicos utilizados pelo SAAE Linhares"})]}),(0,o().jsxs)("div",{className:"search-container",children:[(0,o().j