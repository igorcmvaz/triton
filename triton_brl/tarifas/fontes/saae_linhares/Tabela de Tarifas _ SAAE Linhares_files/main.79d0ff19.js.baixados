t(135deg, #0066b3, #00a896);\n          border-radius: 2px;\n        }\n\n        .header-description {\n          color: #64748b;\n          margin-top: 1rem;\n        }\n\n        .locations-list {\n          display: flex;\n          flex-direction: column;\n          gap: 2rem;\n        }\n\n        .location-item {\n          background: white;\n          border-radius: 20px;\n          overflow: hidden;\n          box-shadow: 0 2px 8px rgba(0,0,0,0.05);\n          border: 1px solid #e9ecef;\n          transition: all 0.3s ease;\n        }\n\n        .location-item:hover {\n          transform: translateY(-4px);\n          box-shadow: 0 8px 24px rgba(0,0,0,0.1);\n        }\n\n        .location-info {\n          padding: 1.5rem;\n          border-bottom: 1px solid #e9ecef;\n        }\n\n        .location-info h2 {\n          font-size: 1.3rem;\n          color: #0066b3;\n          margin-bottom: 1rem;\n        }\n\n        .location-info p {\n          display: flex;\n          align-items: center;\n          gap: 0.75rem;\n          margin-bottom: 0.75rem;\n          color: #4a5568;\n          font-size: 0.95rem;\n        }\n\n        .location-info svg {\n          color: #0066b3;\n          font-size: 1rem;\n        }\n\n        .location-map {\n          width: 100%;\n          height: 300px;\n        }\n\n        .location-map iframe {\n          width: 100%;\n          height: 100%;\n        }\n\n        .no-locations {\n          text-align: center;\n          padding: 3rem;\n          background: white;\n          border-radius: 16px;\n          color: #64748b;\n        }\n\n        .loading-container {\n          display: flex;\n          flex-direction: column;\n          align-items: center;\n          justify-content: center;\n          min-height: 400px;\n        }\n\n        .spinner {\n          width: 40px;\n          height: 40px;\n          border: 3px solid #e2e8f0;\n          border-top-color: #0066b3;\n          border-radius: 50%;\n          animation: spin 1s linear infinite;\n          margin-bottom: 1rem;\n        }\n\n        @keyframes spin {\n          to { transform: rotate(360deg); }\n        }\n\n        @media (max-width: 768px) {\n          .localizacao-page {\n            padding: 2rem 0;\n          }\n\n          .page-header h1 {\n            font-size: 1.8rem;\n          }\n\n          .location-info {\n            padding: 1rem;\n          }\n\n          .location-info h2 {\n            font-size: 1.1rem;\n          }\n\n          .location-info p {\n            font-size: 0.85rem;\n          }\n\n          .location-map {\n            height: 250px;\n          }\n        }\n      "})]})},kd=()=>{const[e,n]=(0,s().useState)([]),[t,a]=(0,s().useState)("all"),[r,i]=(0,s().useState)(""),l=[{id:1,question:"Como fazer o pedido de liga\xe7\xe3o de \xe1gua e esgoto?",answer:"Comparecer ao balc\xe3o de atendimento do SAAE, com os documentos do im\xf3vel (escritura, recibo ou contrato de compra) al\xe9m dos documentos pessoais. Caso as liga\xe7\xf5es forem para Distritos, os consumidores dever\xe3o procurar os funcion\xe1rios do SAAE daquela localidade.<br/><br/>\n      <strong>OBS:</strong> Se nos documentos apresentados n\xe3o constar n\xfamero de quadra e lote, \xe9 necess\xe1rio tamb\xe9m a apresentar uma conta de \xe1gua de um vizinho mais pr\xf3ximo poss\xedvel do im\xf3vel como refer\xeancia de localiza\xe7\xe3o para o atendente.",category:"Liga\xe7\xe3o"},{id:2,question:"Quando \xe9 necess\xe1rio trocar o hidr\xf4metro?",answer:"O hidr\xf4metro \xe9 um aparelho utilizado para medir o consumo de \xe1gua com precis\xe3o e, por isso, \xe9 aferido pelo Instituto Nacional de Metrologia \u2013 Inmetro. Por\xe9m, com o tempo, o desgaste natural de seu mecanismo faz alterar, para menos, o resultado da medi\xe7\xe3o da quantidade de \xe1gua. Por esse motivo, pode haver necessidade da coloca\xe7\xe3o de um hidr\xf4metro novo no lugar do antigo.",category:"Hidr\xf4metro"},{id:3,question:"Como \xe9 feito o c\xe1lculo do consumo?",answer:"Antes, o c\xe1lculo da cobran\xe7a era feito de forma direta, multiplicando-se todo o consumo medido pelo valor do m\xb3 (metro c\xfabico) da faixa correspondente da tarifa. Hoje, na forma de cobran\xe7a em cascata, \xe9 considerada a tarifa de cada faixa de consumo para determinar o valor final.<br/><br/>\n      Cada faixa tem um valor diferente para o m\xb3, que vai aumentando gradualmente, faixa a faixa. Assim, o cliente que consumir entre 0 e 10m\xb3 (1\xaa faixa) de \xe1gua no m\xeas, pagar\xe1 a taxa m\xednima. Se ele consumir nas outras faixas, pagar\xe1 o valor de cada faixa + o proporcional da faixa em que se encontrar seu consumo.",category:"Conta"},{id:4,question:"Por que \xe9 necess\xe1rio ter reservat\xf3rio para solicitar a liga\xe7\xe3o de \xe1gua?",answer:'Porque, de acordo com o artigo n\xba 33 do Regulamento do SAAE de Linhares, "Toda edifica\xe7\xe3o dever\xe1 ter reservat\xf3rio de \xe1gua, que ser\xe1 dimensionado de acordo com as Normas T\xe9cnicas e espec\xedficas da ABNT (Associa\xe7\xe3o Brasileira de Normas T\xe9cnicas), observado o que disp\xf5em as posturas municipais em vigor, e \xe0s expensas dos interessados.',category:"Liga\xe7\xe3o"},{id:5,question:"O que fazer quando se identifica um aumento do consumo em uma fatura, acima da m\xe9dia?",answer:"Primeiramente o usu\xe1rio dever\xe1 verificar suas instala\xe7\xf5es internas e se h\xe1 vazamentos em seu im\xf3vel. Se n\xe3o encontrar nenhum vazamento, deve se dirigir ao balc\xe3o de atendimento do SAAE, levando consigo uma fatura de \xe1gua do referido im\xf3vel bem como a leitura atualizada do medidor (hidr\xf4metro). Ao fazer a leitura, o usu\xe1rio dever\xe1 anotar apenas os algarismos de cor preta, contando da esquerda para a direita do medidor.",category:"Conta"},{id:6,question:"De quem \xe9 a responsabilidade por vazamento interno de \xe1gua no im\xf3vel?",answer:"O SAAE \xe9 respons\xe1vel pela liga\xe7\xe3o de \xe1gua at\xe9 o hidr\xf4metro. Ao usu\xe1rio, cabe responder pela conserva\xe7\xe3o das instala\xe7\xf5es hidr\xe1ulicas internas do im\xf3vel e pelo controle de seu consumo di\xe1rio, devendo evitar desperd\xedcios.",category:"Vazamento"},{id:7,question:"Como fazer o pedido de religa\xe7\xe3o?",answer:"Apresentar no balc\xe3o de atendimento do SAAE as faturas quitadas, para preenchimento do requerimento de religa\xe7\xe3o.",category:"Liga\xe7\xe3o"}].filter(e=>{const n="all"===t||e.category===t,a=e.question.toLowerCase().includes(r.toLowerCase())||e.answer.toLowerCase().includes(r.toLowerCase());return n&&a});return(0,o().jsxs)(Os,{children:[(0,o().jsxs)($n,{children:[(0,o().jsx)("title",{children:"Perguntas Frequentes | SAAE Linhares"}),(0,o().jsx)("meta",{name:"description",content:"Tire suas d\xfavidas sobre servi\xe7os, contas, hidr\xf4metro e mais"})]}),(0,o().jsx)(Ps,{items:[{label:"In\xedcio",link:"/"},{label:"Atendimento",link:null},{label:"Perguntas Frequentes"}]}),(0,o().jsx)("div",{className:"page-content",children:(0,o().jsxs)("div",{className:"container",children:[(0,o().jsxs)("div",{className:"faq-header",children:[(0,o().jsx)("h1",{children:"Perguntas Frequentes"}),(0,o().jsx)("p",{className:"header-description",children:"Tire suas d\xfavidas sobre os servi\xe7os do SAAE Linhares"})]}),(0,o().jsx)("div",{className:"search-container",children:(0,o().jsxs)("div",{className:"search-box",children:[(0,o().jsx)(Lo,{className:"search-icon"}),(0,o().jsx)("input",{type:"text",placeholder:"Pesquisar perguntas...",value:r,onChange:e=>i(e.target.value)}),r&&(0,o().jsx)("button",{className:"search-clear",onClick:()=>i(""),children:"\xd7"})]})}),(0,o().jsxs)("div",{className:"faq-categories",children:[(0,o().jsx)("button",{className:"category-btn "+("all"===t?"active":""),onClick:()=>a("all"),children:"Todas"}),["Liga\xe7\xe3o","Hidr\xf4metro","Conta","Vazamento"].map(e=>(0,o().jsx)("button",{className:"category-btn "+(t===e?"active":""),onClick:()=>a(e),children:e},e))]}),(0,o().jsxs)("di