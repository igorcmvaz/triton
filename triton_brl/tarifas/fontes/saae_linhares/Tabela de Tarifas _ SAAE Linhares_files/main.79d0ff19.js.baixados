2;\n        }\n\n        .stat-icon.orange {\n          background: #fff3e0;\n          color: #f57c00;\n        }\n\n        .stat-icon.teal {\n          background: #e0f2f1;\n          color: #00695c;\n        }\n\n        .stat-icon.pink {\n          background: #fce4ec;\n          color: #c2185b;\n        }\n\n        .stat-info {\n          flex: 1;\n        }\n\n        .stat-value {\n          display: block;\n          font-size: 2rem;\n          font-weight: 700;\n          color: #1a2b3c;\n          line-height: 1.2;\n        }\n\n        .stat-label {\n          display: block;\n          color: #64748b;\n          font-size: 0.9rem;\n          margin-top: 0.25rem;\n        }\n\n        .recent-activity {\n          background: white;\n          border-radius: 16px;\n          padding: 1.5rem;\n          border: 1px solid #e9ecef;\n        }\n\n        .recent-activity h2 {\n          display: flex;\n          align-items: center;\n          gap: 0.5rem;\n          font-size: 1.2rem;\n          color: #1a2b3c;\n          margin-bottom: 1.5rem;\n          padding-bottom: 0.75rem;\n          border-bottom: 2px solid #e9ecef;\n        }\n\n        .activity-list {\n          list-style: none;\n          padding: 0;\n          margin: 0;\n        }\n\n        .activity-item {\n          display: flex;\n          align-items: center;\n          gap: 1rem;\n          padding: 1rem 0;\n          border-bottom: 1px solid #f0f0f0;\n        }\n\n        .activity-item:last-child {\n          border-bottom: none;\n        }\n\n        .activity-icon {\n          width: 40px;\n          height: 40px;\n          border-radius: 50%;\n          background: #f8f9fa;\n          display: flex;\n          align-items: center;\n          justify-content: center;\n          color: #0066b3;\n          font-size: 1rem;\n        }\n\n        .activity-content {\n          flex: 1;\n        }\n\n        .activity-content p {\n          margin: 0 0 0.25rem 0;\n          color: #2c