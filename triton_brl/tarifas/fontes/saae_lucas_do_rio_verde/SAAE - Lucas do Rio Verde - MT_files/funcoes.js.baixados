function sysModalBoxVideo(url, nome, tamanho){
	
	var urlFinal = url;
	console.log(urlFinal);
	if( tamanho != 'undefined' ){
		tamanho = tamanho;
	}else{
		tamanho ='';
	}

	if( nome != 'undefined' ){
		nome = 'name="'+nome+'"';
	}

	var box = url.length;
	var onModalHide = function() {
	    $('#modalBox'+box).remove();
	};
	var arq = url.split('?');
	var html = '<div class="modal modal-video fade" id="modalBox'+box+'" '+nome+' role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">';
		html+= '	<div class="modal-dialog '+tamanho+'">';
		html+= '		<div class="modal-content">';
		//html+= '			<div class="modal-body">';
		html+= '				<button type="button" class="close close-video" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>';
		html+= '				<div id="modalBoxDetalhe'+box+'">';
		html+= '					<div class=" text-center"><img src="http://www.lucasdorioverde.mt.gov.br/site/assets/images/preloader_3.gif" width="64" height="64"><br> Carregando...</div>';
		html+= '				</div>';
		//html+= '			</div>';
		html+= '		</div>';
		html+= '	</div>';
		html+= '</div>';
		
		
	jQuery('#divModalBox').append( html );
	$('#modalBox'+box).modal('show');
	$('#modalBoxDetalhe'+box).load( urlFinal + "&embedded=true");
		$('#modalBox'+box).on('hidden.bs.modal', function (e) {
			$('#modalBox'+box).remove();
		});
	}




function sysModalBox(title, url, width, height, data, alerta, nome, tamanho, color, bclose){
	if( data == true ){
		if( validSelect() == false ){
			return false;
		}
		var idMov =  validSelect();
		var urlFinal = url + '&id=' + idMov;
	}else{
		var urlFinal = url;
	}
	if( alerta != 'undefined' ){
		alerta = 'alert alert-'+alerta;
	}
	if( nome != 'undefined' ){
		nome = 'name="'+nome+'"';
	}


	if( tamanho != 'undefined' ){
		tamanho = tamanho;
	}else{
		tamanho ='';
	}

	if( bclose === 'true' ){
		bclose = 'data-backdrop="static" data-keyboard="false"';
	}else{
		bclose ='';
	}

	if(color != 'undefined'){
		color = 'panel-'+color;
	}else{
		color = 'panel-default';
	}

	var html = '<div class="modal fade" id="modalBox" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true" '+bclose+'>';
		html+= '	<div class="modal-dialog '+tamanho+'">';
		html+= '		<div class="panel '+color+' modal-conteudo">';
		html+= '			<div class="panel-heading panel-heading-padrao">';
		html+= '				<button type="button" class="close close-modal-sysModalBoxJs panel-button-close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>';
		html+= '				<h4 class="modal-title">'+title+'</h4>';
		html+= '			</div>';
		html+= '			<div class="row modal-body modal-body-frame" id="modalBoxDetalhe">';
		html+= '				<div class="col-xs-12 text-center" id="loading">';
		html+= '					<br>';
		html+= '					<br>';
		html+= '					<img src="http://www.lucasdorioverde.mt.gov.br/site/assets/images/preloader_3.gif" width="64" height="64">';
		html+= '				</div>';
		html+= '				<iframe src="' + urlFinal + '&embedded=true" '+nome+' width="100%" height="'+height+'" style="border: none; background-color:#ffffff;" onload="jaCarregado()"></iframe>';
		html+= '			</div>';
		html+= '		</div>';
		html+= '	</div>';
		html+= '</div>';
		
		jQuery('#divModalBox').append( html );
		$('#modalBox').modal('show');
		//$('#modalBoxDetalhe').load( urlFinal + "&embedded=true");
		$('#modalBox').on('hidden.bs.modal', function (e){
			//onExitModal();
			$('#modalBox').remove();
		});
				
	}


function jaCarregado(){
	$("#loading").hide().delay( 800 );
}


