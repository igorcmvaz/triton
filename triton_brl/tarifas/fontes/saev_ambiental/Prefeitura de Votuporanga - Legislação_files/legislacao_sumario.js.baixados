(function(){"use strict";var MIN_ARTIGOS=2;var SCROLL_OFFSET=100;var PREVIEW_CHARS=80;var RE_ROTULO_CITACAO=/(?:onde\s+se\s+l[êe]|leia[\s-]*se|(?:nova|seguinte)\s+reda[çc][ãa]o|seguinte\s+altera[çc][ãa]o|reda[çc][ãa]o\s+(?:anterior|atual))\s*:?\s*$/i;function rotuloCitacaoAntes(el){try{var n=el.previousSibling;var buf='';var guard=0;while(n&&guard++<30){if(n.nodeType===1&&n.tagName==='BR'){if(buf.replace(/\s+/g,' ').trim())break}else{buf=(n.nodeType===3?(n.nodeValue||''):(n.textContent||''))+buf;if(n.nodeType===1&&n.id&&/^a-\d+/i.test(n.id))break}
n=n.previousSibling}
return RE_ROTULO_CITACAO.test(buf.replace(/\s+/g,' ').trim())}catch(e){return!1}}
var TAGS_BLOCO={P:1,LI:1,DIV:1,TD:1,TH:1,BLOCKQUOTE:1,SECTION:1,ARTICLE:1,H1:1,H2:1,H3:1,H4:1,H5:1,H6:1,BODY:1};function textoVazio(txt){return(txt||'').replace(/&nbsp;|&#160;|&#xA0;/gi,' ').replace(/[\s ]+/g,'')===''}
function ehInicioDeLinha(el){try{var atual=el;var guard=0;while(atual&&guard++<2000){var n=atual.previousSibling;while(n){if(n.nodeType===1){if(n.tagName==='BR')return!0;if(!textoVazio(n.textContent))return!1}else if(n.nodeType===3){if(!textoVazio(n.nodeValue))return!1}
n=n.previousSibling}
var pai=atual.parentNode;if(!pai||pai.nodeType!==1)return!0;if(TAGS_BLOCO[pai.tagName])return!0;atual=pai}}catch(e){}
return!0}
function init(){try{var conteudo=document.getElementById('conteudo_norma');var btn=document.querySelector('.swop-sum-btn-toggle');if(!conteudo||!btn)return;var arvore=parsearConteudo(conteudo);if(!arvore||arvore.totalArtigos<MIN_ARTIGOS){return}
var grupo=document.getElementById('leg_grupo_navegacao');if(grupo)grupo.classList.add('swop-sum-disponivel');var drawerCriado=!1;btn.addEventListener('click',function(){if(!drawerCriado){construirDrawer(arvore);drawerCriado=!0}
abrirDrawer()})}catch(e){console.warn('[Sumário] Falha na inicialização:',e)}}
function getTextoNormalizado(el){if(!el)return'';try{var html=(el.innerHTML||'').replace(/<[^>]+>/g,' ');var tmp=document.createElement('div');tmp.innerHTML=html;var t=(tmp.textContent||tmp.innerText||'').replace(/\s+/g,' ').trim();return t}catch(e){return(el.textContent||'').replace(/\s+/g,' ').trim()}}
function parsearConteudo(conteudo){var arvore={itens:[],totalArtigos:0};var pilha=[arvore];var elementos=Array.prototype.slice.call(conteudo.querySelectorAll('h2, h3, h4, p, li, div, strong, b, span.leg_numero_artigo'));var ementaJaPulada=!1;var hSeq=0;var strongsConsumidos=new Set();var artigosNaArvore=new Set();function adicionarArtigo(numero,idArt,preview){if(artigosNaArvore.has(numero))return!1;artigosNaArvore.add(numero);var nodoArt={tipo:'artigo',numero:numero,preview:preview,id:idArt};pilha[pilha.length-1].itens?pilha[pilha.length-1].itens.push(nodoArt):pilha[pilha.length-1].filhos.push(nodoArt);arvore.totalArtigos++;return!0}
elementos.forEach(function(el){try{var tag=el.tagName;if(tag==='DIV'){var temFilhoBloco=el.querySelector('h2, h3, h4, p, li');if(temFilhoBloco)return}
if(tag==='H2'||tag==='H3'||tag==='H4'){var textoH=getTextoNormalizado(el);if(!textoH)return;if(tag==='H2'&&!ementaJaPulada){ementaJaPulada=!0;return}
var nivel=identificarNivelHeading(tag,textoH);var id=el.id;if(!id){hSeq++;id='swop-sum-h-runtime-'+hSeq;el.id=id}
var nodo={tipo:'secao',nivel:nivel,texto:textoH.length>120?textoH.slice(0,120)+'…':textoH,id:id,filhos:[]};while(pilha.length>1&&(pilha[pilha.length-1].nivel||-1)>=nivel){pilha.pop()}
pilha[pilha.length-1].itens?pilha[pilha.length-1].itens.push(nodo):pilha[pilha.length-1].filhos.push(nodo);nodo.itens=nodo.filhos;pilha.push(nodo);return}
if(tag==='P'||tag==='LI'||tag==='DIV'){var artInfo=detectarArtigo(el);if(!artInfo)return;if(rotuloCitacaoAntes(el))return;if(!artInfo.id&&!/^Art(?:igo)?\b/i.test(getTextoNormalizado(el)))return;var firstStrong=el.firstElementChild;if(firstStrong&&(firstStrong.tagName==='STRONG'||firstStrong.tagName==='B')){strongsConsumidos.add(firstStrong)}
if(!el.id&&!artInfo.id){el.id='swop-sum-art-runtime-'+artInfo.numero}
var idArt=artInfo.id||el.id;var textoBloco=getTextoNormalizado(el);var preview=(textoBloco.replace(/^Art(?:igo)?\.?\s*\d+(?:\s*-\s*[A-Z](?!\w))?\s*[º°]?\s*[—–\-]?\s*/i,'')||'').trim();if(preview.length>PREVIEW_CHARS)preview=preview.slice(0,PREVIEW_CHARS)+'…';adicionarArtigo(artInfo.numero,idArt,preview);return}
if(tag==='STRONG'||tag==='B'||(tag==='SPAN'&&el.classList.contains('leg_numero_artigo'))){if(strongsConsumidos.has(el))return;if(rotuloCitacaoAntes(el))return;if(!ehInicioDeLinha(el))return;var t=(el.textContent||'').replace(/\s+/g,' ').trim();if(!t)return;var m=t.match(/^Art(?:igo)?\.?\s*(\d+(?:\s*-\s*[A-Z](?!\w))?)\s*[º°]?/i);if(!m)return;var numero=normalizarNumeroArtigo(m[1]);var seloFilho=el.classList.contains('leg_numero_artigo')?null:el.querySelector('.leg_numero_artigo');if(seloFilho)strongsConsumidos.add(seloFilho);if(!el.id)el.id='swop-sum-art-runtime-'+numero;if(!el.classList.contains('leg_numero_artigo')&&!seloFilho){el.classList.add('leg_numero_artigo')}
var preview2='';var brSeguidos=0;var n=el.nextSibling;while(n&&preview2.length<PREVIEW_CHARS+20){if(n.nodeType===1){var tg=n.tagName;if(tg==='STRONG'||tg==='B')break;if(tg==='BR'){brSeguidos++;if(brSeguidos>=2)break}else{preview2+=' '+(n.textContent||'');brSeguidos=0}}else if(n.nodeType===3){var txt=(n.nodeValue||'').replace(/\s+/g,' ');if(txt.trim()){preview2+=' '+txt;brSeguidos=0}}
n=n.nextSibling}
preview2=preview2.replace(/\s+/g,' ').trim();if(preview2.length>PREVIEW_CHARS)preview2=preview2.slice(0,PREVIEW_CHARS)+'…';adicionarArtigo(numero,el.id,preview2);return}}catch(e){console.warn('[Sumário] Falha ao processar elemento:',e,el)}});return arvore}
function parsearArtigosFlat(conteudo,arvore){var marcadores=conteudo.querySelectorAll('strong, b');Array.prototype.forEach.call(marcadores,function(el){try{if(!ehInicioDeLinha(el))return;var t=(el.textContent||'').replace(/\s+/g,' ').trim();if(!t)return;var m=t.match(/^Art(?:igo)?\.?\s*(\d+(?:\s*-\s*[A-Z](?!\w))?)\s*[º°]?/i);if(!m)return;var numero=normalizarNumeroArtigo(m[1]);if(!el.id)el.id='swop-sum-art-runtime-'+numero;if(!el.classList.contains('leg_numero_artigo')){el.classList.add('leg_numero_artigo')}
var preview='';var brSeguidos=0;var n=el.nextSibling;while(n&&preview.length<PREVIEW_CHARS+20){if(n.nodeType===1){var tg=n.tagName;if(tg==='STRONG'||tg==='B')break;if(tg==='BR'){brSeguidos++;if(brSeguidos>=2)break}else{preview+=' '+(n.textContent||'');brSeguidos=0}}else if(n.nodeType===3){var txt=(n.nodeValue||'').replace(/\s+/g,' ');if(txt.trim()){preview+=' '+txt;brSeguidos=0}}
n=n.nextSibling}
preview=preview.replace(/\s+/g,' ').trim();if(preview.length>PREVIEW_CHARS)preview=preview.slice(0,PREVIEW_CHARS)+'…';arvore.itens.push({tipo:'artigo',numero:numero,preview:preview,id:el.id});arvore.totalArtigos++}catch(e){console.warn('[Sumário] Falha no parser flat:',e,el)}})}
function identificarNivelHeading(tag,texto){var t=texto.toUpperCase();if(/^TÍTULO\b/.test(t)||/^TITULO\b/.test(t))return 1;if(/^CAPÍTULO\b/.test(t)||/^CAPITULO\b/.test(t))return 2;if(/^SEÇÃO\b/.test(t)||/^SECAO\b/.test(t))return 3;if(/^SUBSEÇÃO\b/.test(t)||/^SUBSECAO\b/.test(t))return 4;if(tag==='H2')return 1;if(tag==='H3')return 2;if(tag==='H4')return 3;return 2}
function detectarArtigo(el){if(el.id&&/^a-(\d+[A-Z]*)$/i.test(el.id)){return{numero:RegExp.$1.toUpperCase(),id:el.id}}
var first=el.firstElementChild;if(first&&(first.tagName==='STRONG'||first.tagName==='B'||first.tagName==='SPAN')){var t=(first.textContent||'').trim();var m=t.match(/^Art(?:igo)?\.?\s*(\d+(?:\s*-\s*[A-Z](?!\w))?)\s*[º°]?/i);if(m){var idAttr=first.id&&/^a-\d+[A-Z]*$/i.test(first.id)?first.id:null;return{numero:normalizarNumeroArtigo(m[1]),id:idAttr}}}
var raw=(el.textContent||'').trim();var m2=raw.match(/^Art(?:igo)?\.?\s*(\d+(?:\s*-\s*[A-Z](?!\w))?)\s*[º°]?/i);if(m2){return{numero:normalizarNumeroArtigo(m2[1]),id:null}}
return null}
function normalizarNumeroArtigo(s){return String(s).toUpperCase().replace(/\s+/g,'').replace(/[^0-9A-Z]/g,'')}
function formatarNumeroArtigo(s){var str=String(s);return str.replace(/^(\d+)([A-Z]+)$/i,'$1-$2')}
function construirDrawer(arvore){var backdrop=document.createElement('div');backdrop.className='swop-sum-backdrop';backdrop.id='swop-sum-backdrop';var drawer=document.createElement('aside');drawer.className='swop-sum-drawer';drawer.id='swop-sum-drawer';drawer.setAttribute('role','dialog');drawer.setAttribute('aria-label','Sumário da norma');var header=document.createElement('div');header.className='swop-sum-drawer-header';header.innerHTML='<h3>Sumário</h3>'+'<button type="button" class="swop-sum-drawer-fechar" aria-label="Fechar sumário">✕</button>';var body=document.createElement('div');body.className='swop-sum-drawer-body';body.appendChild(renderizarArvore(arvore));drawer.appendChild(header);drawer.appendChild(body);document.body.appendChild(backdrop);document.body.appendChild(drawer);backdrop.addEventListener('click',fecharDrawer);header.querySelector('.swop-sum-drawer-fechar').addEventListener('click',fecharDrawer);document.addEventListener('keyup',function(e){if(e.key==='Escape')fecharDrawer()});body.addEventListener('click',function(e){var a=e.target.closest('a[data-swop-sum-target]');if(!a)return;e.preventDefault();var alvoId=a.getAttribute('data-swop-sum-target');scrollParaAncora(alvoId);if(window.innerWidth<=600)fecharDrawer()})}
function renderizarArvore(arvore){var ul=document.createElement('ul');ul.className='swop-sum-lista';renderizarItens(arvore.itens,ul,0);return ul}
function renderizarItens(itens,ulPai,nivel){itens.forEach(function(it){var li=document.createElement('li');if(it.tipo==='secao'){li.className='swop-sum-secao swop-sum-nivel-'+Math.min(nivel,3);var aSec=document.createElement('a');aSec.href='#'+it.id;aSec.setAttribute('data-swop-sum-target',it.id);aSec.textContent=it.texto;li.appendChild(aSec);if(it.itens&&it.itens.length){var subUl=document.createElement('ul');subUl.className='swop-sum-lista';renderizarItens(it.itens,subUl,nivel+1);li.appendChild(subUl)}}else if(it.tipo==='artigo'){li.className='swop-sum-artigo swop-sum-nivel-'+Math.min(nivel,3);var aArt=document.createElement('a');aArt.href='#'+it.id;aArt.setAttribute('data-swop-sum-target',it.id);aArt.innerHTML='<span class="swop-sum-artigo-badge">Art. '+formatarNumeroArtigo(it.numero)+'</span>'+'<span class="swop-sum-artigo-preview"></span>';aArt.querySelector('.swop-sum-artigo-preview').textContent=it.preview||'';li.appendChild(aArt)}
ulPai.appendChild(li)})}
function abrirDrawer(){var d=document.getElementById('swop-sum-drawer');var b=document.getElementById('swop-sum-backdrop');if(d)d.classList.add('swop-sum-aberto');if(b)b.classList.add('swop-sum-aberto')}
function fecharDrawer(){var d=document.getElementById('swop-sum-drawer');var b=document.getElementById('swop-sum-backdrop');if(d)d.classList.remove('swop-sum-aberto');if(b)b.classList.remove('swop-sum-aberto')}
function scrollParaAncora(id){var alvo=document.getElementById(id);if(!alvo)return;var top=(alvo.getBoundingClientRect().top+window.pageYOffset)-SCROLL_OFFSET;if(window.jQuery&&window.jQuery.fn.animate){window.jQuery('html, body').animate({scrollTop:top},600)}else{window.scrollTo({top:top,behavior:'smooth'})}
try{alvo.style.transition='background .3s';var bgOrig=alvo.style.backgroundColor;alvo.style.backgroundColor='#fff3a0';setTimeout(function(){alvo.style.backgroundColor=bgOrig},1200)}catch(e){}}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init)}else{init()}})()