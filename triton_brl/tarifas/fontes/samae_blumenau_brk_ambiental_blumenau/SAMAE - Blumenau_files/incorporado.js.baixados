/*
 * BL-18 - o lado do navegador do bloqueio do conteudo incorporado (issue #26)
 *
 * Implementa a R6 da regra de consentimento, em
 * docs/regra-de-consentimento-e-textos.md: "Conteudo incorporado recusado vira
 * capa com botao. O clique carrega SO AQUELE item, SO NAQUELA visita - nao
 * altera a escolha salva e nao vale para o resto do site."
 *
 * O QUE ESTE ARQUIVO FAZ E O QUE ELE NAO FAZ. Ele devolve o src que o servidor
 * guardou em data-src, de um item por vez. Ele NAO le nem grava cookie nenhum,
 * NAO conversa com o consentimento.js e NAO decide o que e impresso - quem
 * decide isso e o PHP, no incorporado.php, antes de a pagina sair. Se este
 * arquivo nao carregar, nenhum terceiro carrega: o botao simplesmente nao
 * responde, que e o lado seguro do defeito.
 *
 * POR ISSO O CARREGAMENTO PONTUAL NAO VIRA CONSENTIMENTO. Nada e gravado, entao
 * a proxima pagina - e a proxima visita - volta a bloquear. E a diferenca entre
 * "carregar so aqui" e "aceitar a categoria", e o cidadao continua tendo a
 * segunda opcao no link do rodape.
 *
 * ES5 de proposito, como o consentimento.js: o site nao passa por transpilador
 * nenhum e ainda carrega jQuery 1.7.2.
 */
(function () {
	'use strict';

	/*
	 * Um clique delegado no documento inteiro, e nao um ouvinte por caixa. A
	 * /videos chega a ter 98 delas, e o conteudo do CMS pode trazer quantas a
	 * Comunicacao colar na noticia.
	 */
	document.addEventListener('click', function (evento) {
		var alvo = evento.target;

		while (alvo && alvo !== document && !(alvo.getAttribute && alvo.getAttribute('data-incorporado-carregar') !== null)) {
			alvo = alvo.parentNode;
		}
		if (!alvo || alvo === document) {
			return;
		}

		var caixa = alvo;
		while (caixa && caixa !== document && !temClasse(caixa, 'incorporado_caixa')) {
			caixa = caixa.parentNode;
		}
		var recipiente = caixa;
		while (recipiente && recipiente !== document && !temClasse(recipiente, 'incorporado')) {
			recipiente = recipiente.parentNode;
		}
		if (!caixa || caixa === document || !recipiente || recipiente === document) {
			return;
		}

		evento.preventDefault();
		carregar(recipiente, caixa);
	}, false);

	/*
	 * A classe e conferida na mao porque classList nao existe nos navegadores
	 * antigos que este site ainda atende, e "incorporado" e prefixo de
	 * "incorporado_caixa" - um indexOf solto acharia a caixa procurando o
	 * recipiente.
	 */
	function temClasse(elemento, nome) {
		if (!elemento.className || typeof elemento.className !== 'string') {
			return false;
		}
		return (' ' + elemento.className + ' ').indexOf(' ' + nome + ' ') >= 0;
	}

	/*
	 * Carrega um item. Sao tres movimentos, nesta ordem: devolver o src de tudo
	 * que o servidor guardou em data-src (o <iframe> do flipbook ou do video, o
	 * <img> da miniatura da galeria), mostrar o que nasceu oculto e tirar a
	 * caixa da frente.
	 *
	 * O src e a UNICA coisa que muda. A ancora da galeria ja nasceu com o
	 * FancyBox ligado, porque foi impressa junto com a pagina - ver o comentario
	 * de incorporadoVideoGaleria(), no incorporado.php.
	 */
	function carregar(recipiente, caixa) {
		var guardados = recipiente.querySelectorAll('[data-src]');
		var i;

		for (i = 0; i < guardados.length; i++) {
			guardados[i].setAttribute('src', guardados[i].getAttribute('data-src'));
			guardados[i].removeAttribute('data-src');
		}

		var ocultos = recipiente.querySelectorAll('[hidden]');
		for (i = 0; i < ocultos.length; i++) {
			ocultos[i].removeAttribute('hidden');
		}

		if (caixa.parentNode) {
			caixa.parentNode.removeChild(caixa);
		}

		/*
		 * O botao que acabou de sumir era o elemento com foco. Sem isto, quem
		 * navega por teclado voltaria para o comeco da pagina a cada item
		 * carregado. O alvo e o proprio conteudo que apareceu no lugar.
		 */
		var novo = recipiente.getElementsByTagName('a')[0] || recipiente.getElementsByTagName('iframe')[0];
		if (novo) {
			if (!novo.getAttribute('tabindex') && novo.tagName.toLowerCase() === 'iframe') {
				novo.setAttribute('tabindex', '-1');
			}
			try {
				novo.focus();
			} catch (erro) {
			}
		}
	}
})();
