(function($,Drupal,once){'use strict';Drupal.behaviors.saneparFooter={attach:function(context,settings){const footerPc=$('#footer-pc',context);once('transparenciaLinksBlank','#transparencia',context).forEach(function(transparenciaEl){$('a[href]',transparenciaEl).each(function(){const $a=$(this);const href=($a.attr('href')||'').trim();if(!href||href==='#'||href.startsWith('#')||href.startsWith('javascript:'))return;$a.attr('target','_blank');const rel=($a.attr('rel')||'').toLowerCase();const relSet=new Set(rel.split(/\s+/).filter(Boolean));relSet.add('noopener');relSet.add('noreferrer');$a.attr('rel',Array.from(relSet).join(' '));});});if(footerPc.length){once('moveSaibaMais','#saiba-mais-pc',footerPc[0]).forEach(function(){const saibaMaisBtn=$('#saiba-mais-pc',footerPc).detach();$('div.l-contacts-articles-wrapper.column-left',footerPc).after(saibaMaisBtn);});$('[id^="js-random-"]',footerPc).css({'display':'flex','flex-direction':'column'});}once('moveLastElement','#footer-pc #accordion-contacts-digital .l-contacts-articles-wrapper').forEach(function(element){const lastElement=$('div div:nth-last-child(2)',element).has('.ouvidoria').detach();$('div div:nth-last-child(1)',element).has('.canal-integro').after(lastElement);});}};})(jQuery,Drupal,once);;
(function($,Drupal,once){Drupal.behaviors.headerBehaviors={attach:function(context,settings){once('headerBehaviors','html',context).forEach(function(element){$(document).ready(function(){$('.menu-level-1').on('click',function(){var listItem=$(this).parent('.li-level-1');var siblingsItens=listItem.siblings();siblingsItens.removeClass('is-expanded').addClass('is-collapsed');siblingsItens.find('.menu-level-2-wrapper').css('display','none');});let windowWidth=window.innerWidth;if(windowWidth>=767){$('li.dropdown-layout').each(function(index){if($(this).hasClass('internal-menu-open')){let listItems=$(this).find('.menu-level-2 > li.li-level-2');let i=0;while(i<listItems.length){let currentItem=$(listItems[i]);if(currentItem.hasClass('has-children')){const wrapper=$('<li class="group-wrapper"><ul></ul></li>');currentItem.wrapAll(wrapper);i+=1;}else{let group=[];while(i<listItems.length&&!$(listItems[i]).hasClass('has-children')&&group.length<5){group.push(listItems[i]);i+=1;}const wrapper=$('<li class="group-wrapper column-direction"><ul></ul></li>');$(group).wrapAll(wrapper);}}}else{let listItems=$(this).find('.menu-level-2 > li.li-level-2');for(let i=0;i<listItems.length;i+=5){const group=listItems.slice(i,i+5);const wrapper=$('<li class="group-wrapper"><ul></ul</li>');group.wrapAll(wrapper);}}});$('li.dropdown-layout .menu-level-2-link').on('click',function(){if(!$(this).parents('.li-level-1').hasClass('internal-menu-open')){$(this).siblings('.menu-level-3').toggleClass('menu-d-block menu-d-none');var $parent=$(this).parent();if($parent.hasClass('has-children'))$parent.toggleClass('is-expanded is-collapsed');var listItemWrapper=$(this).parents('li.group-wrapper');var siblingsItensWrapper=listItemWrapper.siblings();var listItemInternal=$(this).parent();var siblingsItensInternal=listItemInternal.siblings('.has-children');siblingsItensInternal.removeClass('is-expanded').addClass('is-collapsed');siblingsItensInternal.find('.menu-level-3').removeClass('menu-d-block').addClass('menu-d-none');siblingsItensWrapper.find('.li-level-2.has-children').removeClass('is-expanded').addClass('is-collapsed');siblingsItensWrapper.find('.menu-level-3').removeClass('menu-d-block').addClass('menu-d-none');}else{$(this).siblings('.menu-level-3').toggleClass('menu-d-block menu-d-none');$(this).parent().toggleClass('is-expanded is-collapsed');}});$('li.internal-menu-open li.li-level-2.has-children').removeClass('is-collapsed').addClass('is-expanded');$('li.internal-menu-open div.menu-level-3').removeClass('menu-d-none').addClass('menu-d-block');$('.menu-level-1').on('click',function(event){if(event.target===this&&!$(this).hasClass('internal-menu-open')){$(this).parent().find('.li-level-2.has-children').removeClass('is-expanded').addClass('is-collapsed');$(this).parent().find('.menu-level-3').removeClass('menu-d-block').addClass('menu-d-none');}});$(document).on('click',function(event){if(!$(event.target).closest('.menu-level-2-wrapper').length&&!$(event.target).closest('.expanded-wave-container').length&&!$(event.target).closest('#header-component').length){$('li.li-level-1').removeClass('is-expanded').addClass('is-collapsed');$('.menu-level-2-wrapper').css('display','none');}});}else{$('.menu-level-1').on('click',function(event){if(event.target===this){$(this).parent().find('.li-level-2.has-children').removeClass('is-expanded').addClass('is-collapsed');$(this).parent().find('.menu-level-3').removeClass('menu-d-block').addClass('menu-d-none');}});$('.menu-level-2-link').on('click',function(){$(this).siblings('.menu-level-3').toggleClass('menu-d-block menu-d-none');$(this).parent().toggleClass('is-expanded is-collapsed');var listItemInternal=$(this).parent();var siblingsItensInternal=listItemInternal.siblings('.has-children');siblingsItensInternal.removeClass('is-expanded').addClass('is-collapsed');siblingsItensInternal.find('.menu-level-3').removeClass('menu-d-block').addClass('menu-d-none');});}});});}};})(jQuery,Drupal,once);;
(function($,Drupal,drupalSettings,once){'use strict';Drupal.behaviors.cohesionIconPicker={attach:function(context,settings){const buttons=once('cohesion-icon-picker','.cohesion-icon-picker-button',context);buttons.forEach(function(button){const $button=$(button);const pickerId=$button.data('icon-picker-id');const $container=$('#'+pickerId);const $input=$container.find('.cohesion-icon-picker-value');const iconData=drupalSettings.cohesionIconPicker?drupalSettings.cohesionIconPicker[pickerId]:null;if(!iconData||!iconData.icons)return;$button.on('click',function(e){e.preventDefault();openIconPickerModal(pickerId,$input,$container,iconData);});});const clearButtons=once('cohesion-icon-picker-clear','.cohesion-icon-picker-clear',context);clearButtons.forEach(function(button){const $button=$(button);const pickerId=$button.data('icon-picker-id');const $container=$('#'+pickerId);const $input=$container.find('.cohesion-icon-picker-value');$button.on('click',function(e){e.preventDefault();$input.val('');updatePreview($container,null);$button.hide();});});}};function openIconPickerModal(pickerId,$input,$container,iconData){const currentValue=$input.val();const icons=iconData.icons;console.log('Icon picker data:',iconData);console.log('Total icons:',icons?icons.length:0);const librariesMap={};icons.forEach((icon)=>{if(!librariesMap[icon.library_id])librariesMap[icon.library_id]={label:icon.library_label,icons:[]};librariesMap[icon.library_id].icons.push(icon);});const $modal=$('<div>').addClass('cohesion-icon-picker-modal').attr('data-picker-id',pickerId);const $modalContent=$('<div>').addClass('cohesion-icon-picker-modal-content');const $header=$('<div>').addClass('cohesion-icon-picker-modal-header');$header.append($('<h2>').text(Drupal.t('Choose an icon')));const $closeBtn=$('<button>').addClass('cohesion-icon-picker-modal-close').html('&times;');$closeBtn.on('click',function(){$modal.remove();});$header.append($closeBtn);$modalContent.append($header);const $searchContainer=$('<div>').addClass('cohesion-icon-picker-search');const $searchInput=$('<input>').attr('type','text').attr('placeholder',Drupal.t('Search icons...'));$searchContainer.append($searchInput);$modalContent.append($searchContainer);const $librariesContainer=$('<div>').addClass('cohesion-icon-picker-libraries');const $librarySelect=$('<select>');$librarySelect.append($('<option>').val('').text(Drupal.t('All libraries')));Object.keys(librariesMap).forEach((libId)=>{$librarySelect.append($('<option>').val(libId).text(librariesMap[libId].label));});$librariesContainer.append($librarySelect);$modalContent.append($librariesContainer);const $gridContainer=$('<div>').addClass('cohesion-icon-picker-grid-container');const $grid=$('<div>').addClass('cohesion-icon-picker-grid');icons.forEach((icon)=>{const $item=$('<div>').addClass('cohesion-icon-picker-item').attr('data-icon-key',icon.library_id+':'+icon.icon_name).attr('data-library-id',icon.library_id).attr('data-icon-name',icon.icon_name.toLowerCase());if(currentValue===icon.library_id+':'+icon.icon_name)$item.addClass('selected');const $iconSpan=$('<span>').addClass('cohesion-icon-picker-item-icon').css('font-family',icon.font_family);if(icon.icon_code)$iconSpan.html('&#'+icon.icon_code+';');const $nameSpan=$('<span>').addClass('cohesion-icon-picker-item-name').text(icon.icon_name);$item.append($iconSpan);$item.append($nameSpan);$item.on('click',function(){$grid.find('.cohesion-icon-picker-item').removeClass('selected');$item.addClass('selected');});$grid.append($item);});$gridContainer.append($grid);$modalContent.append($gridContainer);const $noResults=$('<div>').addClass('cohesion-icon-picker-no-results').text(Drupal.t('No icons found')).hide();$gridContainer.append($noResults);const $footer=$('<div>').addClass('cohesion-icon-picker-modal-footer');const $selectBtn=$('<button>').addClass('button button--primary').text(Drupal.t('Select'));const $cancelBtn=$('<button>').addClass('button').text(Drupal.t('Cancel'));$selectBtn.on('click',function(){const $selected=$grid.find('.cohesion-icon-picker-item.selected');if($selected.length){const iconKey=$selected.attr('data-icon-key');$input.val(iconKey).trigger('change');const [libId,iconName]=iconKey.split(':');const selectedIcon=icons.find((i)=>i.library_id===libId&&i.icon_name===iconName);updatePreview($container,selectedIcon);}$modal.remove();});$cancelBtn.on('click',function(){$modal.remove();});$footer.append($selectBtn);$footer.append($cancelBtn);$modalContent.append($footer);$modal.append($modalContent);$('body').append($modal);$searchInput.on('input',function(){filterIcons($grid,$searchInput.val(),$librarySelect.val(),$noResults);});$librarySelect.on('change',function(){filterIcons($grid,$searchInput.val(),$librarySelect.val(),$noResults);});setTimeout(function(){$modal.addClass('active');},10);$(document).on('keydown.iconpicker',function(e){if(e.key==='Escape'){$modal.remove();$(document).off('keydown.iconpicker');}});$modal.on('click',function(e){if(e.target===$modal[0])$modal.remove();});}function filterIcons($grid,searchTerm,libraryId,$noResults){const search=searchTerm.toLowerCase();let visibleCount=0;$grid.find('.cohesion-icon-picker-item').each(function(){const $item=$(this);const iconName=$item.attr('data-icon-name');const itemLibraryId=$item.attr('data-library-id');let visible=true;if(search&&iconName.indexOf(search)===-1)visible=false;if(libraryId&&itemLibraryId!==libraryId)visible=false;if(visible){$item.removeClass('hidden');visibleCount++;}else $item.addClass('hidden');});if(visibleCount===0)$noResults.show();else $noResults.hide();}function updatePreview($container,iconData){const $current=$container.find('.cohesion-icon-picker-current');$current.empty();if(iconData){const $preview=$('<span>').addClass('cohesion-icon-preview').css({'font-family':iconData.font_family,'font-size':'32px'});if(iconData.icon_code)$preview.html('&#'+iconData.icon_code+';');const $label=$('<span>').addClass('cohesion-icon-name').text(iconData.icon_name);$current.append($preview);$current.append($label);$container.find('.cohesion-icon-picker-clear').show();}else{$current.append('<em>'+Drupal.t('No icon selected')+'</em>');$container.find('.cohesion-icon-picker-clear').hide();}}})(jQuery,Drupal,drupalSettings,once);;
(function($,Drupal,once){Drupal.behaviors.hidePageElements={attach:function(context,settings){once("hidePageElements","html",context).forEach(function(element){$(document).ready(function(){function toggleVisibility(fieldSelector,containerSelector){var fieldValue=$(fieldSelector,context).text().trim();var $container=$(containerSelector,context);if(fieldValue==="1")$container.css("display","none");else $container.css("display","flex");}toggleVisibility(".field_hide_page_title:first",".container-title");toggleVisibility(".field_hide_stamps:first",".container-stamps");});});}};})(jQuery,Drupal,once);;
(function($,Drupal,once){Drupal.behaviors.languageSwitcherToggle={attach:function(context,settings){once("languageSwitcherToggle",".el-language-switcher-button",context).forEach(function(switcher){const $switcher=$(switcher);const $dropdown=$switcher.next();const $images=$switcher.find("img");const $arrowIcon=$images.eq(1);if($dropdown.length===0)return;$dropdown.css({overflow:"hidden","max-height":"0px",transition:"max-height 0.3s ease",display:"none"});$arrowIcon.css({transition:"transform 0.3s ease",transform:"rotate(0deg)"});let isOpen=false;$switcher.on("click",function(){isOpen=!isOpen;if(isOpen){$dropdown.css("display","block");setTimeout(function(){$dropdown.css("max-height",$dropdown[0].scrollHeight+"px");},10);$arrowIcon.css("transform","rotate(180deg)");}else{$dropdown.css("max-height","0px");setTimeout(function(){$dropdown.css("display","none");},300);$arrowIcon.css("transform","rotate(0deg)");}});const htmlLang=document.documentElement.lang||"";if(htmlLang){const langEl=$switcher.find(".coh-ce-cpt_header-3cbd2f7c");if(langEl.length)langEl.text(htmlLang.toUpperCase());}});}};})(jQuery,Drupal,once);;
(function($,Drupal,once){'use strict';Drupal.behaviors.loadingOverlay={attach:function(context,settings){$(once('loadingOverlay','.coh-container.loading-overlay',context)).each(function(){const $overlay=$(this);let isOverlayVisible=false;let ajaxCount=0;let hideTimeout;const showOverlay=function(){clearTimeout(hideTimeout);if(isOverlayVisible)return;$overlay.css({'display':'flex','opacity':'1'});isOverlayVisible=true;};const hideOverlay=function(){if(!isOverlayVisible||ajaxCount>0)return;$overlay.css('opacity','0');hideTimeout=setTimeout(function(){$overlay.css('display','none');isOverlayVisible=false;},300);};showOverlay();$(window).on('load',hideOverlay);setTimeout(hideOverlay,5000);$(document).ajaxStart(function(){ajaxCount++;showOverlay();}).ajaxStop(function(){ajaxCount=Math.max(0,ajaxCount-1);if(ajaxCount===0)hideOverlay();}).ajaxError(function(){ajaxCount=Math.max(0,ajaxCount-1);if(ajaxCount===0)hideOverlay();});$(document).on('click','.use-ajax, .pager__link, .views-ajax-form input[type="submit"]',function(){setTimeout(showOverlay,100);});});}};})(jQuery,Drupal,once);;
(function($,Drupal,once){Drupal.behaviors.searchRedirect={attach:function(context,settings){once("searchRedirectBehaviorClick",".button-search",context).forEach(function(element){$(element).on("click",function(e){e.preventDefault();handleSearch();});});setupSearch(".search-input","search-input",context);setupSearch(".search-input-mobile","search-input-mobile",context);function setupSearch(inputClass,inputId,context){once(`searchRedirectBehaviorInput-${inputId}`,inputClass,context).forEach(function(input){$(input).attr("type","text").attr("id",inputId).attr("name",inputId);$(input).on("keydown",function(e){if(e.key==="Enter"){e.preventDefault();handleSearch();}});});$(`#${inputId}`).attr("placeholder","Digite sua busca");}function handleSearch(){var $visibleInput=$('.search-input, .search-input-mobile').filter(':visible');if($visibleInput.length>0){var searchTerm=$visibleInput.val().trim();if(searchTerm!==""){var queryParam=(settings.saneparSearch&&settings.saneparSearch.queryParam)||"search_api_fulltext";window.location.href="/busca?"+encodeURIComponent(queryParam)+"="+encodeURIComponent(searchTerm);}}}}};})(jQuery,Drupal,once);;
(function($,Drupal,once){Drupal.behaviors.tabsIcon={attach:function(context,settings){once('tabsIcon','html').forEach(function(element){$(document).ready(function(){$('.coh-accordion-tabs-content-wrapper .tab-content').each(function(){var tabId=$(this).attr('id');var iconValue=$(this).attr('data-icon');var $link=$('.coh-accordion-tabs-nav li a[href="#'+tabId+'"]');var $mobileLink=$('.coh-accordion-tabs-nav li a[href="#'+tabId+'"]');if($link.length||$mobileLink.length){var values=iconValue.split(";");var iconCode=values[0].trim().replace(/['"]/g,'');var fontFamily=values[1]?values[1].replace("font-family:","").trim():"";var unicodeChar=String.fromCharCode(parseInt(iconCode.replace("\\",""),16));var $iconSpan=$('<span class="tab-icon"></span>').text(unicodeChar);$iconSpan.css("font-family",fontFamily);$link.prepend($iconSpan);if($(window).width()<=767)$mobileLink.prepend($iconSpan);}});});});}};})(jQuery,Drupal,once);;
