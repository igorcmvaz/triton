(function($,Drupal,once){"use strict";Drupal.behaviors.saneparDatepicker={attach:function(context,settings){once("sanepar-datepicker",'.coh-style-webform input[type="date"], .coh-style-webform input.sanepar-datepicker',context).forEach(function(element){if(element.type==="date"){element.type="text";$(element).addClass("sanepar-datepicker");}let minDate=element.getAttribute("min");if(minDate&&minDate.startsWith("+")){const daysToAdd=parseInt(minDate.substring(1),10);const today=new Date();today.setDate(today.getDate()+daysToAdd);minDate=today;}flatpickr(element,{dateFormat:"Y-m-d",locale:{firstDayOfWeek:1,weekdays:{shorthand:["DOM","SEG","TER","QUA","QUI","SEX","SÁB"],longhand:["Domingo","Segunda-feira","Terça-feira","Quarta-feira","Quinta-feira","Sexta-feira","Sábado"]},months:{shorthand:["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"],longhand:["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"]},time_24hr:true},disableMobile:true,static:true,prevArrow:"<span>&lt;</span>",nextArrow:"<span>&gt;</span>",monthSelectorType:"static",showMonths:1,animate:true,position:"auto",altInput:true,altFormat:"d/m/Y",minDate,defaultDate:minDate,onReady:function(selectedDates,dateStr,instance){const originalPrevMonth=instance.calendarContainer.querySelector(".flatpickr-prev-month");const originalNextMonth=instance.calendarContainer.querySelector(".flatpickr-next-month");if(originalPrevMonth&&originalPrevMonth.parentNode)originalPrevMonth.parentNode.removeChild(originalPrevMonth);if(originalNextMonth&&originalNextMonth.parentNode)originalNextMonth.parentNode.removeChild(originalNextMonth);function updateHeader(){const currentMonth=instance.currentMonth;const currentYear=instance.currentYear;let monthName=instance.l10n.months.longhand[currentMonth];monthName=monthName.charAt(0).toUpperCase()+monthName.slice(1);const headerContainer=instance.calendarContainer.querySelector(".flatpickr-month");if(!headerContainer)return;if(headerContainer.querySelector(".month-year-display"))return;headerContainer.innerHTML="";const titleElement=document.createElement("div");titleElement.className="month-year-display";titleElement.textContent=monthName+" "+currentYear;headerContainer.appendChild(titleElement);const navContainer=document.createElement("div");navContainer.className="nav-buttons-container";const prevButton=document.createElement("span");const svgPString=`
                <svg xmlns="http://www.w3.org/2000/svg" width="9" height="16" viewBox="0 0 9 16" fill="none">
                  <path d="M7 2L1 8L7 14" stroke="#0862AD" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"/>
                </svg>
                `;prevButton.className="custom-nav-button prev-button";prevButton.innerHTML=svgPString;prevButton.addEventListener("click",function(e){e.preventDefault();e.stopPropagation();instance.changeMonth(-1);});const nextButton=document.createElement("span");const svgNString=`
                <svg xmlns="http://www.w3.org/2000/svg" width="9" height="16" viewBox="0 0 9 16" fill="none">
                  <path d="M2 14L8 8L2 2" stroke="#0862AD" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"/>
                </svg>
                `;nextButton.className="custom-nav-button next-button";nextButton.innerHTML=svgNString;nextButton.addEventListener("click",function(e){e.preventDefault();e.stopPropagation();instance.changeMonth(1);});navContainer.appendChild(prevButton);navContainer.appendChild(nextButton);headerContainer.appendChild(navContainer);}updateHeader();const buttonContainer=document.createElement("div");buttonContainer.className="flatpickr-buttons";const cancelButton=document.createElement("button");cancelButton.className="flatpickr-cancel";cancelButton.textContent="Cancelar";cancelButton.addEventListener("click",function(){instance.close();});const saveButton=document.createElement("button");saveButton.className="flatpickr-save";saveButton.textContent="Salvar";saveButton.addEventListener("click",function(){instance.close();});buttonContainer.appendChild(cancelButton);buttonContainer.appendChild(saveButton);instance.calendarContainer.appendChild(buttonContainer);},onMonthChange:function(selectedDates,dateStr,instance){setTimeout(function(){const currentMonth=instance.currentMonth;const currentYear=instance.currentYear;let monthName=instance.l10n.months.longhand[currentMonth];monthName=monthName.charAt(0).toUpperCase()+monthName.slice(1);const titleElement=instance.calendarContainer.querySelector(".month-year-display");if(titleElement)titleElement.textContent=monthName+" "+currentYear;},0);}});if(!$(element).attr("placeholder"))$(element).attr("placeholder","Selecione uma data");$(element).closest("form").on("submit",function(){const dateValue=$(element).val();if(dateValue){const parts=dateValue.split("/");if(parts.length===3){const isoDate=parts[2]+"-"+parts[1]+"-"+parts[0];if(!$(element).next('input[type="hidden"]').length)$("<input>").attr({type:"hidden",name:element.name+"_iso",value:isoDate}).insertAfter(element);else $(element).next('input[type="hidden"]').val(isoDate);}}});});}};})(jQuery,Drupal,once);;
(function($,Drupal,once){'use strict';Drupal.behaviors.saneparModalHandler={attach:function(context,settings){once('modal-close-init','.js-modal-close',context).forEach(function(button){$(button).on('click',function(e){e.preventDefault();var $button=$(this);var $dialog=$button.closest('.ui-dialog-content');var $dialogContainer=$button.closest('.ui-dialog');var shouldRedirect=false;var redirectUrl='';if(settings.saneparUtils&&settings.saneparUtils.modal&&settings.saneparUtils.modal.redirectAfterClose){shouldRedirect=true;redirectUrl=settings.saneparUtils.modal.redirectUrl||window.location.href;}if($dialogContainer.hasClass('has-redirect')){shouldRedirect=true;if(!redirectUrl)redirectUrl=window.location.href;}if($dialog.length){$dialog.dialog('close');if(shouldRedirect){var cleanUrl=redirectUrl;if(redirectUrl===window.location.href)cleanUrl=window.location.pathname;else{if(redirectUrl.includes('?_wrapper_format=drupal_ajax')||redirectUrl.includes('&_wrapper_format=drupal_ajax')||redirectUrl.includes('?ajax_form=1')||redirectUrl.includes('&ajax_form=1')){cleanUrl=redirectUrl.replace(/[\?&]_wrapper_format=drupal_ajax/g,'').replace(/[\?&]ajax_form=1/g,'');if(cleanUrl.indexOf('&')===0&&cleanUrl.indexOf('?')===-1)cleanUrl='?'+cleanUrl.substring(1);}}window.location.href=cleanUrl;}}else $('.ui-dialog-content').dialog('close');return false;});});once('dialog-close-redirect','body',context).forEach(function(body){$(document).on('dialogclose','.ui-dialog.has-redirect',function(event){var $dialog=$(this);var shouldRedirect=false;var redirectUrl='';if(settings.saneparUtils&&settings.saneparUtils.modal&&settings.saneparUtils.modal.redirectAfterClose){shouldRedirect=true;redirectUrl=settings.saneparUtils.modal.redirectUrl||window.location.href;}if($dialog.hasClass('has-redirect')){shouldRedirect=true;if(!redirectUrl)redirectUrl=window.location.href;}if(shouldRedirect){var cleanUrl=redirectUrl;if(redirectUrl===window.location.href)cleanUrl=window.location.pathname;else{if(redirectUrl.includes('?_wrapper_format=drupal_ajax')||redirectUrl.includes('&_wrapper_format=drupal_ajax')||redirectUrl.includes('?ajax_form=1')||redirectUrl.includes('&ajax_form=1')){cleanUrl=redirectUrl.replace(/[\?&]_wrapper_format=drupal_ajax/g,'').replace(/[\?&]ajax_form=1/g,'');if(cleanUrl.indexOf('&')===0&&cleanUrl.indexOf('?')===-1)cleanUrl='?'+cleanUrl.substring(1);}}window.location.href=cleanUrl;}});});$(document).on('dialogclose','.ui-dialog',function(event,ui){var $dialog=$(event.target);var redirectUrl=$dialog.attr('data-redirect-url');var shouldRedirect=$dialog.attr('data-redirect-after-close')==='1';if(shouldRedirect&&redirectUrl){var cleanUrl=redirectUrl;if(redirectUrl===window.location.href)cleanUrl=window.location.pathname;else{if(redirectUrl.includes('?_wrapper_format=drupal_ajax')||redirectUrl.includes('&_wrapper_format=drupal_ajax')||redirectUrl.includes('?ajax_form=1')||redirectUrl.includes('&ajax_form=1')){cleanUrl=redirectUrl.replace(/[\?&]_wrapper_format=drupal_ajax/g,'').replace(/[\?&]ajax_form=1/g,'');if(cleanUrl.indexOf('&')===0&&cleanUrl.indexOf('?')===-1)cleanUrl='?'+cleanUrl.substring(1);}}window.location.href=cleanUrl;}});}};})(jQuery,Drupal,once);;
