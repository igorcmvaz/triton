function animateShow(component, duration, callback = null) {
	component.css('visibility', 'visible');
	component.css('opacity', 1);

	component.animate({
		height: component.get(0).scrollHeight
	}, duration, function() {
		if (callback !== null) {
			callback();
		}
		component.height('auto');
	});
}

function animateHide(component, duration, callback = null) {
	component.animate({ height: 0, opacity: 0 }, duration, function() {
		if (callback !== null) {
			callback();
		}
		component.css('visibility', 'hidden');
	});
}
