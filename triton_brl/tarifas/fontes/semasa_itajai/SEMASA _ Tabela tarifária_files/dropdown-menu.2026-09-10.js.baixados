(function ($) {

	const defaultOptions = {
		hoverable: false,
		hasRootLink: false,
		sticky: false,
		animation: 'slide-down' // options: slide-down, false
	};

	$.fn.dropdownMenu = function (options) {
		const o = $.extend({}, defaultOptions, options);
		const component = this;
		const button = component.children('.dropdown-btn');
		const menu = component.children('.dropdown-menu');

		if (o.animation === 'slide-down') {
			menu.addClass('slide-down');
		}

		if (o.hoverable) {
			/**
			 * Ao passar o mouse em cima do componente, abre o menu
			 */
			component.on('mouseenter', function() {
				if (this.timer) { window.clearTimeout(this.timer); }
				openMenu();
			});

			/**
			 * Ao sair com o mouse do componente,
			 * após um pequeno delay, fecha o menu
			 */
			component.on('mouseleave', function() {
				this.timer = window.setTimeout(function() {
						closeMenu();
					}, 70);
			});
		}

		/**
		 * Gerencia o abrir e fechar do menu ao clicar no botão do dropdown
		 */
		button.on('click', function(event) {
			if (component.hasClass('open')) {
				if (!o.hasRootLink) {
					event.preventDefault();
					closeMenu();
				}
				// Se o botão possuir um link próprio, deixa ele ser ativado
			} else {
				event.preventDefault();
				openMenu();
			}
		});

		/**
		 * Ao clicar no menu, se ele não for "grudento", fecha-o
		 */
		menu.on('click', function() {
			if (!o.sticky) {
				closeMenu();
			}
		});

		/**
		 * Abre este menu dropdown
		 */
		function openMenu() {
			if (o.animation === 'slide-down') {
				animateShow(menu, 150, function() {
					component.addClass('open');
				});
			} else {
				component.addClass('open');
			}
			// Adiciona listener pra poder fechar o menu mais tarde
			$(document).on('click', clickHandler);
		}

		/**
		 * Se o usuário clicar fora do menu, fecha-o.
		 *
		 * @param eventObject event
		 */
		function clickHandler(event) {
			if (component.has(event.target).length === 0) {
				closeMenu();
				// Remove este listener
				$(document).off('click', clickHandler);
			}
		}

		/**
		 * Fecha este menu dropdown
		 */
		function closeMenu() {
			if (o.animation === 'slide-down') {
				animateHide(menu, 80, function() {
					component.removeClass('open');
				});
			} else {
				component.removeClass('open');
			}
		}

		return this;
	};
}(jQuery));
